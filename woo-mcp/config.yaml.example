# WooCommerce MCP Server Configuration

# WooCommerce store base URL
store_url: "https://your-store.example.com"

# WooCommerce REST API credentials
consumer_key: "ck_your_consumer_key"
consumer_secret: "cs_your_consumer_secret"

# Path to RSA public key PEM file for JWT verification
public_key_path: "/path/to/public_key.pem"

# MCP server identification (optional, defaults shown)
server_name: "WooCommerce-MCP"
server_version: "1.0.0"

# Transport mode: "stdio" | "http" | "both"
transport: "stdio"

# HTTP server port (used when transport is "http" or "both")
http_port: 8080

# Enable UCP profile and REST endpoints
ucp_enabled: true

# Enable A2UI card rendering in tool responses
a2ui_enabled: true

# Super user mode: trusted backend process, skips OAuth token validation
# for REST endpoints. Use for backend integrations with merchant-level access.
# When false (default), customer-facing mode: OAuth required for identity linking.
super_user: false

# WordPress page IDs containing store policies (optional)
store_policies_page_ids: []

# OAuth 2.0 clients for UCP Identity Linking (Phase 6)
# Each client needs a unique client_id, a secret, and allowed redirect URIs
oauth_clients:
  - client_id: "platform-agent-001"
    client_secret: "change-me-to-a-secure-secret"
    redirect_uris:
      - "https://platform.example.com/oauth/callback"
